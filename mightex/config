NAME=mightex
PORT=4059
HOST=hirrixs2
USER=softioc
CHDIR=/opt/epics/iocs/mightex/iocBoot/iocmightex
EXEC=/opt/epics/iocs/mightex/iocBoot/iocmightex/start_epics.sh

