text {
	object {
		x=10
		y=5
		width=740
		height=25
	}
	"basic attribute" {
		clr=14
	}
	textix="Mightex 16-Channel LED Controller -- Overview"
	align="horiz. centered"
}

"related display" {
	object {
		x=10
		y=35
		width=120
		height=22
	}
	display[0] {
		label="Device"
		name="mightexDevice.adl"
		args="P=$(P)"
	}
	clr=14
	bclr=51
	label="Device Screen"
}

text {
	object {
		x=10
		y=65
		width=60
		height=18
	}
	"basic attribute" {
		clr=14
	}
	textix="Channel"
}
text {
