		y=65
		width=100
		height=18
	}
	"basic attribute" {
		clr=14
	}
	textix="Detail"
}

"related display" {
	object {
		x=10
		y=90
		width=100
		height=20
	}
	display[0] {
		label="Ch1"
		name="mightexChannel.adl"
		args="P=$(P),R=Ch1:"
	}
	clr=14
	bclr=51
	label="Ch1"
}
menu {
	object {
		x=140
		y=90
		width=110
		height=20
	}
	control {
		chan="$(P)Ch1:Mode-Sel"
		clr=14
		bclr=51
	}
}
"text update" {
	object {
		x=260
		y=90
		width=60
		height=20
	}
	monitor {
		chan="$(P)Ch1:Mode-Sts"
		clr=14
		bclr=3
	}
	align="horiz. centered"
	format="decimal"
	limits {
	}
}
"text update" {
	object {
		x=340
		y=90
		width=170
		height=20
	}
	monitor {
		chan="$(P)Ch1:Current-RB"
		clr=14
		bclr=3
	}
	align="horiz. centered"
	format="decimal"
	limits {
	}
}
"text update" {
	object {
		x=530
		y=90
		width=90
		height=20
	}
	monitor {
		chan="$(P)Ch1:TimedOut-Sts"
		clr=14
		bclr=3
	}
	"dynamic attribute" {
		vis="if not zero"
		calc="A"
		chan="$(P)Ch1:TimedOut-Sts"
	}
	align="horiz. centered"
	format="string"
	limits {
	}
}

