text {
	object {
		x=10
		y=5
		width=610
		height=25
	}
	"basic attribute" {
		clr=14
	}
	textix="Mightex LED Controller -- Device"
	align="horiz. centered"
}

text {
	object {
		x=10
		y=40
		width=100
		height=20
	}
	"basic attribute" {
		clr=14
	}
	textix="Device info"
}
"text update" {
	object {
		x=10
		y=63
		width=610
		height=40
	}
	monitor {
		chan="$(P)DeviceInfo-RB"
		clr=14
		bclr=3
	}
	align="horiz. centered"
	format="string"
	limits {
	}
}

text {
	object {
		x=10
		y=120
		width=610
		height=14
	}
	"basic attribute" {
		clr=10
	}
	textix="Reset: soft device reset -- CAUSES USB RE-ENUMERATION, needs manual"
	align="horiz. centered"
}
text {
	object {
		x=10
		y=134
		width=610
		height=14
	}
	"basic attribute" {
		clr=10
	}
	textix="utnm recovery afterward. See manual before using outside testing."
	align="horiz. centered"
}
"message button" {
	object {
		x=10
		y=155
		width=150
		height=25
	}
	control {
		chan="$(P)Reset-Cmd"
		clr=14
		bclr=20
	}
	label="Reset"
	press_msg="1"
}

"message button" {
	object {
		x=190
		y=155
		width=190
		height=25
	}
	control {
		chan="$(P)RestoreDefault-Cmd"
		clr=14
		bclr=34
	}
	label="Restore Defaults"
	press_msg="1"
}

"message button" {
	object {
		x=410
		y=155
		width=150
		height=25
	}
	control {
		chan="$(P)Store-Cmd"
		clr=14
		bclr=51
	}
	label="Store"
	press_msg="1"
}

text {
	object {
		x=10
		y=190
		width=610
		height=14
	}
	"basic attribute" {
		clr=10
	}
	textix="Restore Defaults resets ALL channels to factory Imax/Iset (20/10 mA)"
	align="horiz. centered"
}

"related display" {
	object {
		x=10
		y=220
		width=120
		height=25
	}
	display[0] {
		label="Overview"
		name="mightexOverview.adl"
		args="P=$(P)"
	}
	clr=14
	bclr=51
	label="Overview"
}
