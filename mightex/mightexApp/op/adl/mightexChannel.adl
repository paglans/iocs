text {
	object {
		x=10
		y=280
		width=100
		height=20
	}
	"basic attribute" {
		clr=14
	}
	textix="Timed out"
}
"text update" {
	object {
		x=120
		y=280
		width=110
		height=20
	}
	monitor {
		chan="$(P)$(R)TimedOut-Sts"
		clr=14
		bclr=3
	}
	"dynamic attribute" {
		vis="if not zero"
		calc="A"
		chan="$(P)$(R)TimedOut-Sts"
	}
	align="horiz. centered"
	format="string"
	limits {
	}
}

# ---- Back to overview ----
