# ---- Mode ----
text {
	object {
		x=10
		y=40
		width=100
		height=20
	}
	"basic attribute" {
		clr=14
	}
	textix="Mode"
}
menu {
	object {
		x=120
		y=40
		width=110
		height=20
	}
	control {
		chan="$(P)$(R)Mode-Sel"
		clr=14
		bclr=51
	}
}
text {
	object {
		x=240
		y=40
		width=60
		height=20
	}
	"basic attribute" {
		clr=14
	}
	textix="raw:"
	align="horiz. right"
}
"text update" {
	object {
		x=305
		y=40
		width=50
		height=20
	}
	monitor {
		chan="$(P)$(R)Mode-Sts"
		clr=14
		bclr=3
	}
	align="horiz. centered"
	format="decimal"
	limits {
	}
}
text {
	object {
		x=10
		y=64
		width=610
		height=14
	}
	"basic attribute" {
		clr=10
	}
	textix="(0=Disable 1=Normal 2=Strobe 3=Trigger -- readback is raw integer, see manual)"
	align="horiz. centered"
}

